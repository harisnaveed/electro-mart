## Your products API endpoint.
## This app expects your response to contain an array at one of:
## - products
## - items
## - results
## - data
## Tip (recommended for local dev): use the Vite proxy to avoid CORS
VITE_PRODUCTS_API_URL=/api/v2/inventory/search

## DO NOT COMMIT REAL KEYS.
## Put your real key in a local `.env` file (gitignored by default).
VITE_API_KEY=YOUR_API_KEY_HERE

## Optional: search query parameter name (depends on your API)
## Common values: query, q, search, term
VITE_QUERY_PARAM=query

